(ns unwired-epistemology.platform.invitation-codec-test
  (:require [clojure.test :refer [deftest is]]
            [unwired-epistemology.domain.invitation :as invitation]
            [unwired-epistemology.platform.invitation-codec :as codec]))

(deftest offer-round-trips-through-alphanumeric-code
  (let [offer (invitation/join-offer
                :room/alpha :peer/creator :connection.mode/dynamic
                "public-key" "nonce-1" 2000000000000)
        encoded (codec/encode offer)]
    (is (re-matches #"[A-Za-z0-9]+" encoded))
    (is (= offer (codec/decode encoded)))
    (is (.endsWith (codec/url offer) encoded))))

(deftest response-round-trips-through-alphanumeric-code
  (let [offer (invitation/join-offer
                :room/alpha :peer/creator :connection.mode/dynamic
                "creator-key" "offer-nonce" 2000000000000)
        response (invitation/join-response
                   offer :peer/joiner "joiner-key" "response-nonce")]
    (is (= response (codec/decode (codec/encode response))))))

(deftest compressed-webrtc-description-remains-alphanumeric-and-round-trips
  (let [sdp (apply str (repeat 40 "a=candidate:1 1 UDP 2122260223 192.0.2.1 5000 typ host\r\n"))
        offer (invitation/join-offer
                :room/remote :peer/creator :connection.mode/strictly-remote
                "key" "nonce" 2000000000000 sdp)
        encoded (codec/encode offer)]
    (is (re-matches #"[A-Za-z0-9]+" encoded))
    (is (= sdp (:transport/webrtc-sdp (codec/decode encoded))))
    (is (< (count encoded) (count (str sdp sdp))))))
