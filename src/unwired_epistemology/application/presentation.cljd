(ns unwired-epistemology.application.presentation)

(def likert-labels
  {1 "Strongly Disagree"
   2 "Disagree"
   3 "Slightly Disagree"
   4 "Neutral"
   5 "Slightly Agree"
   6 "Agree"
   7 "Strongly Agree"})

(def connection-labels
  {:connection.mode/strictly-local "Strictly Local"
   :connection.mode/strictly-remote "Strictly Remote"
   :connection.mode/dynamic "Dynamic Auto-Discovery"})

(def admission-labels
  {:admission.mode/creator-only "Creator only"
   :admission.mode/moderators "Creator and moderators"
   :admission.mode/any-member "Any active member"})

(defn- action [label event]
  {:action/label label :action/event event})

(defn- spectrum-actions [event-type]
  (mapv (fn [value]
          (action (get likert-labels value)
                  {:event/type event-type :vote/value value}))
        (range 1 8)))

(defn- spectrum [state]
  (let [members (get-in state [:app/room :room/members])]
    {:spectrum/zones (mapv (fn [value]
                             {:spectrum/value value
                              :spectrum/label (get likert-labels value)})
                           (range 1 8))
     :spectrum/markers
     (->> (get-in state [:app/vote :vote/positions])
          (map (fn [[member-id value]]
                 {:marker/member-id member-id
                  :marker/nickname (get-in members [member-id :member/nickname]
                                           "Anonymous participant")
                  :marker/value value}))
          (sort-by (juxt :marker/value :marker/nickname))
          vec)}))

(defn view [state dispatch!]
  (let [screen (:app/screen state)
        local-id (:app/local-member-id state)
        nickname (or (get-in state [:app/room :room/members local-id :member/nickname])
                     "Anonymous participant")
        position (get-in state [:app/vote :vote/positions local-id])
        pending (vals (get-in state [:app/room :room/pending-joins]))
        discovered (vals (:app/discovered-peers state))
        members (vals (get-in state [:app/room :room/members]))
        creator? (= local-id (get-in state [:app/room :room/creator-id]))
        moderator? (or creator?
                       (contains? (get-in state [:app/room :room/moderator-ids])
                                  local-id))
        base {:view/title "Unwired Epistemology"
              :view/screen screen
              :view/dispatch! dispatch!}]
    (merge
      base
      (case screen
        :view.screen/home
        {:view/heading "P2P Spectrum"
         :view/status (or (:app/admission-message state)
                          "Choose how peers may connect")
         :view/inputs [{:input/label "Paste a room code or invitation link"
                        :input/value (:app/invitation-draft state)
                        :input/event-type :event/invitation-draft-changed
                        :input/value-key :invitation/text}]
         :view/actions
         (into [(action "Scan invitation QR"
                        {:event/type :event/scan-invitation})]
               (concat
                 (when (seq (:app/invitation-draft state))
                   [(action "Request to join room"
                            {:event/type :event/join-with-invitation})])
                 (map (fn [[mode label]]
                        (action (str "Create " label " room")
                                {:event/type :event/create-room
                                 :room/connection-mode mode}))
                      [[:connection.mode/dynamic "Dynamic"]
                       [:connection.mode/strictly-local "Local-only"]
                       [:connection.mode/strictly-remote "Remote-only"]])))}

        :view.screen/room
        {:view/heading (str nickname "'s room")
         :view/status "Choose the first question"
         :view/details [(str "Mode: "
                             (get connection-labels
                                  (get-in state [:app/room :room/connection-mode])))
                        (str "Admission: "
                             (get admission-labels
                                  (get-in state [:app/room :room/admission-mode])))
                        (str "Participants: " nickname)
                        (str "Nearby/known peers: " (count discovered))
                        (str "Pending join requests: " (count pending))]
         :view/inputs [{:input/label "Write a claim for room approval"
                        :input/value (:app/question-draft state)
                        :input/event-type :event/question-draft-changed
                        :input/value-key :question/text}
                       {:input/label "Paste a returned join-response code"
                        :input/value (:app/invitation-draft state)
                        :input/event-type :event/invitation-draft-changed
                        :input/value-key :invitation/text}]
         :view/actions (cond->
                         [(action "Invite people (code, link or QR)"
                                  {:event/type :event/share-room})
                          (action "Catalogue: knowledge and certainty"
                                  {:event/type :event/use-catalogue-question
                                   :question/id :catalogue/knowledge-certainty})
                          (action "Catalogue: law and justice"
                                  {:event/type :event/use-catalogue-question
                                   :question/id :catalogue/law-and-justice})
                          (action "Catalogue: social responsibility"
                                  {:event/type :event/use-catalogue-question
                                   :question/id :catalogue/social-responsibility})
                          (action "Catalogue: free expression"
                                  {:event/type :event/use-catalogue-question
                                   :question/id :catalogue/free-expression})]
                         (seq (:app/invitation-draft state))
                         (conj (action "Open returned join request"
                                       {:event/type :event/complete-join-response}))
                         (seq (:app/question-draft state))
                         (conj (action "Submit claim for approval"
                                       {:event/type :event/submit-custom-question}))
                         true
                         (into (concat
                                [(action "Admission: creator only"
                                        {:event/type :event/set-admission-mode
                                         :room/admission-mode :admission.mode/creator-only})
                                (action "Admission: creator + moderators"
                                        {:event/type :event/set-admission-mode
                                         :room/admission-mode :admission.mode/moderators})
                                (action "Admission: any member"
                                        {:event/type :event/set-admission-mode
                                         :room/admission-mode :admission.mode/any-member})]
                                (mapcat
                                  (fn [request]
                                    [(action (str "Approve " (:member/nickname request))
                                             {:event/type :event/approve-join
                                              :member/id (:member/id request)})
                                     (action (str "Reject " (:member/nickname request))
                                             {:event/type :event/reject-join
                                              :member/id (:member/id request)})])
                                  pending)
                                (mapcat
                                  (fn [member]
                                    (let [member-id (:member/id member)
                                          is-moderator (contains?
                                                         (get-in state [:app/room :room/moderator-ids])
                                                         member-id)]
                                      (concat
                                        (when (and creator? (not= member-id local-id))
                                          [(action
                                             (str (if is-moderator "Revoke moderator: "
                                                      "Make moderator: ")
                                                  (:member/nickname member))
                                             {:event/type :event/set-moderator
                                              :member/id member-id
                                              :moderator/enabled? (not is-moderator)})])
                                        (when (and moderator? (not= member-id local-id))
                                          [(action (str "Remove " (:member/nickname member))
                                                   {:event/type :event/remove-member
                                                    :member/id member-id})]))))
                                  members))))}

        :view.screen/scan-invitation
        {:view/heading "Scan a room invitation"
         :view/status "Point the camera at the room QR code"
         :view/scanner {:scanner/event-type :event/qr-detected}
         :view/actions [(action "Cancel" {:event/type :event/reset})]}

        :view.screen/preparing-invitation
        {:view/heading "Preparing direct connection"
         :view/status "Gathering WebRTC connection candidates…"
         :view/details ["The invitation will appear automatically."]
         :view/actions []}

        :view.screen/preparing-response
        {:view/heading "Preparing join response"
         :view/status "Creating the direct WebRTC answer…"
         :view/details ["No signaling server is being used."]
         :view/actions []}

        :view.screen/share-response
        {:view/heading "Return this response to the room"
         :view/status "The room must approve your request before you join"
         :view/details ["Share this response with an existing room member."]
         :view/share {:share/code (get-in state [:app/join-response
                                                 :invitation/response-text])
                      :share/url (str "unwiredepistemology://response/"
                                      (get-in state [:app/join-response
                                                     :invitation/response-text]))
                      :share/qr (get-in state [:app/join-response
                                               :invitation/response-text])}
         :view/actions [(action "Return home" {:event/type :event/reset})]}

        :view.screen/share-room
        {:view/heading "Invite people to this room"
         :view/status "One end-to-end invitation, available in every format"
         :view/details ["A join request still requires approval after exchange."]
         :view/share {:share/code (get-in state [:app/invitation :invitation/text])
                      :share/url (get-in state [:app/invitation :invitation/url])
                      :share/qr (get-in state [:app/invitation :invitation/url])}
         :view/actions [(action "Back to room"
                                {:event/type :event/back-to-room})]}

        :view.screen/question-pending
        {:view/heading (:question/text (:app/question state))
         :view/status "Waiting for democratic approval"
         :view/details [(str (count (get-in state [:app/question :question/approvals]))
                             " approval(s) of "
                             (count (get-in state [:app/question :question/electorate]))
                             " active participant(s)")]
         :view/actions [(action "Approve this claim"
                                {:event/type :event/approve-custom-question})
                        (action "Return to room and add another"
                                {:event/type :event/back-to-room})]}

        :view.screen/question-ready
        {:view/heading (:question/text (:app/question state))
         :view/status "The question is approved"
         :view/details [(str "Approved by " nickname)]
         :view/actions [(action "Start voting"
                                {:event/type :event/start-vote})]}

        :view.screen/voting
        {:view/heading (:question/text (:app/question state))
         :view/status (if (:app/selected-value state)
                        (str "Selected: "
                             (get likert-labels (:app/selected-value state)))
                        "Select your private position")
         :view/actions (cond-> (spectrum-actions :event/select-vote)
                         (:app/selected-value state)
                         (conj (action "Submit private vote"
                                       {:event/type :event/submit-vote})))}

        :view.screen/reveal-ready
        {:view/heading "The votes are ready to be revealed."
         :view/status "The spectrum remains locked until you confirm"
         :view/actions [(action "OK"
                                {:event/type :event/acknowledge-reveal})]}

        :view.screen/revealed
        {:view/heading (:question/text (:app/question state))
         :view/status (str nickname ": " (get likert-labels position))
         :view/spectrum (spectrum state)
         :view/actions [(action "Begin discussion"
                                {:event/type :event/begin-discussion})]}

        :view.screen/discussion
        {:view/heading "Discussion spectrum"
         :view/status (str nickname ": " (get likert-labels position))
         :view/details ["Move at any time as your view changes"]
         :view/spectrum (spectrum state)
         :view/actions (into (spectrum-actions :event/reposition)
                             [(action "Continue to next queued question"
                                      {:event/type :event/next-question})])}

        :view.screen/empathy-prompt
        {:view/heading "Consider the opposite perspective"
         :view/status "You are on the opposite side of another participant. Try to guess the exact underlying reason or logical baseline for why they hold their opposing view."
         :view/spectrum (spectrum state)
         :view/inputs [{:input/label "Your private perspective-taking guess"
                        :input/value (:app/empathy-draft state)
                        :input/event-type :event/empathy-draft-changed
                        :input/value-key :empathy/text}]
         :view/actions (when (seq (:app/empathy-draft state))
                         [(action "Send privately to the opposite participant"
                                  {:event/type :event/submit-empathy-message})])}

        :view.screen/empathy-received
        {:view/heading "An opposite participant considered your perspective"
         :view/status (get-in state [:app/empathy-message :empathy/text])
         :view/details ["This guess was delivered only to you."]
         :view/actions [(action "Return to discussion"
                                {:event/type :event/close-empathy-message})]}

        {:view/heading "Unable to continue"
         :view/status (str (:app/error state))
         :view/actions [(action "Return home"
                                {:event/type :event/reset})]}))))
