(ns unwired-epistemology.application.runtime
  (:require [unwired-epistemology.application.presentation :as presentation]
            [unwired-epistemology.application.identity :as identity]
            [unwired-epistemology.application.invitation :as invitation]
            [unwired-epistemology.application.peer-observer :as peer-observer]
            [unwired-epistemology.domain.questions :as questions]
            [unwired-epistemology.domain.room :as room]
            [unwired-epistemology.domain.voting :as voting]))

(def catalogue-question
  {:question/id :catalogue/knowledge-certainty
   :question/text "Knowledge requires certainty"})

(defn initial-state []
  {:app/screen :view.screen/home :app/position-sequence 0})

(defn- failed [state error]
  (assoc state :app/screen :view.screen/error :app/error error))

(declare join-requested)

(defn- create-room [state dependencies event]
  (let [room-id :room/local-preview
        creator (:ok (identity/for-room dependencies room-id))
        result (room/create :room/local-preview
                            (or (:room/connection-mode event)
                                :connection.mode/dynamic)
                            creator
                            (or (:room/admission-mode event)
                                :admission.mode/creator-only))]
    (if-let [created (:ok result)]
      (do
        (when (and (:local/start-host! dependencies)
                   (not= :connection.mode/strictly-remote
                         (:room/connection-mode created)))
          ((:local/start-host! dependencies) (:member/nickname creator)))
        (assoc state
               :app/screen :view.screen/room
               :app/room created
               :app/local-member-id (:member/id creator)))
      (failed state (:error result)))))

(defn- set-admission-mode [state mode]
  (let [result (room/set-admission-mode (:app/room state)
                                        (:app/local-member-id state)
                                        mode)]
    (if-let [updated (:ok result)]
      (assoc state :app/room updated)
      (failed state (:error result)))))

(defn- share-room [state dependencies sdp]
  (let [now (.-millisecondsSinceEpoch (DateTime/now))
        offer (invitation/create-join-offer (assoc dependencies
                                              :remote/session-description sdp)
                                             (:app/room state)
                                             now 86400000)]
    (assoc state :app/screen :view.screen/share-room
                 :app/invitation offer)))

(defn- begin-share-room [state dependencies]
  (let [mode (get-in state [:app/room :room/connection-mode])]
    (if (and (not= mode :connection.mode/strictly-local)
             (:remote/create-offer! dependencies))
      (do
        ((:remote/create-offer! dependencies)
         (fn [sdp]
           ((:application/emit! dependencies)
            {:event/type :event/webrtc-offer-ready
             :transport/webrtc-sdp sdp})))
        (assoc state :app/screen :view.screen/preparing-invitation))
      (share-room state dependencies nil))))

(defn- invitation-code [value]
  (cond
    (nil? value) ""
    (.contains value "#") (last (.split value "#"))
    (.contains value "/") (last (.split value "/"))
    :else value))

(defn- accepted-invitation-state [state accepted anonymous encoded]
  (assoc state :app/screen :view.screen/share-response
               :app/local-member-id (:member/id anonymous)
               :app/join-offer (:invitation/offer accepted)
               :app/join-response accepted
               :app/accepted-invitation encoded
               :app/anonymous-identity anonymous))

(defn- accept-invitation [state dependencies value]
  (try
    (let [encoded (invitation-code value)
          offer ((:invitation/decode dependencies) encoded)
          anonymous (:ok (identity/for-room dependencies (:room/id offer)))
          now (.-millisecondsSinceEpoch (DateTime/now))
          result (invitation/accept-join-offer dependencies encoded now anonymous)]
      (if-let [accepted (:ok result)]
        (if-let [webrtc-sdp (:transport/webrtc-sdp offer)]
          (do
            ((:remote/accept-offer! dependencies)
             webrtc-sdp
             (fn [answer]
               ((:application/emit! dependencies)
                {:event/type :event/webrtc-answer-ready
                 :transport/webrtc-sdp answer})))
            (assoc state :app/screen :view.screen/preparing-response
                         :app/accepted-invitation encoded
                         :app/anonymous-identity anonymous))
          (do
          (when (and (:local/join! dependencies)
                     (not= :connection.mode/strictly-remote
                           (:room/connection-mode offer)))
            ((:local/join! dependencies)
             (:member/nickname anonymous)
             (:invitation/response-text accepted)))
            (accepted-invitation-state state accepted anonymous encoded)))
        (failed state (:error result))))
    (catch dynamic error
      (failed state :invitation.error/unreadable-code))))

(defn- complete-response [state dependencies value]
  (try
    (let [offer (get-in state [:app/invitation :invitation/payload])
          encoded (invitation-code value)
          response ((:invitation/decode dependencies) encoded)
          result (invitation/complete-exchange dependencies offer encoded)]
      (if-let [peer (:ok result)]
        (do
          (when-let [answer (:transport/webrtc-sdp response)]
            ((:remote/complete-answer! dependencies) answer))
          (join-requested state
                          {:peer/id (:peer/id peer)
                           :peer/nickname (:peer/nickname peer)
                           :peer/public-key (:peer/public-key peer)}))
        (failed state (:error result))))
    (catch dynamic error
      (failed state :invitation.error/unreadable-response))))

(defn- peer-found [state event]
  (assoc-in state [:app/discovered-peers (:peer/id event)]
            {:peer/id (:peer/id event)
             :peer/nickname (:peer/nickname event)
             :peer/transports (:peer/transports event)
             :peer/status :peer.status/reachable}))

(defn- peer-lost [state event]
  (assoc-in state [:app/discovered-peers (:peer/id event) :peer/status]
            :peer.status/unreachable))

(defn- join-requested [state event]
  (let [request {:member/id (:peer/id event)
                 :member/nickname (:peer/nickname event)
                 :member/public-key (:peer/public-key event)}
        result (room/request-join (:app/room state) request)]
    (if-let [updated (:ok result)]
      (assoc state :app/room updated)
      (failed state (:error result)))))

(defn- decide-join [state event decision]
  (let [result (room/decide-join (:app/room state)
                                 (:app/local-member-id state)
                                 (:member/id event)
                                 decision)]
    (if-let [updated (:ok result)]
      (assoc state :app/room updated)
      (failed state (:error result)))))

(defn- remove-member [state event]
  (let [result (room/remove-member (:app/room state)
                                   (:app/local-member-id state)
                                   (:member/id event))]
    (if-let [updated (:ok result)]
      (assoc state :app/room updated)
      (failed state (:error result)))))

(defn- use-catalogue-question [state]
  (let [electorate (room/active-members (:app/room state))
        submitted (questions/submit (:question/id catalogue-question)
                                    (:question/text catalogue-question)
                                    (:app/local-member-id state)
                                    electorate)
        approved (when-let [question (:ok submitted)]
                   (questions/approve question (:app/local-member-id state)))]
    (if-let [question (:ok approved)]
      (assoc state
             :app/screen :view.screen/question-ready
             :app/question question)
      (failed state (or (:error approved) (:error submitted))))))

(defn- submit-custom-question [state]
  (let [member-id (:app/local-member-id state)
        electorate (room/active-members (:app/room state))
        question-id (str "question-" (inc (count (get-in state [:app/room :room/questions]))))
        result (questions/submit question-id (:app/question-draft state)
                                 member-id electorate)]
    (if-let [question (:ok result)]
      (assoc state :app/screen :view.screen/question-pending
             :app/question question)
      (failed state (:error result)))))

(defn- approve-custom-question [state]
  (let [result (questions/approve (:app/question state)
                                  (:app/local-member-id state))]
    (if-let [question (:ok result)]
      (assoc state
             :app/screen (if (:promoted? result)
                           :view.screen/question-ready
                           :view.screen/question-pending)
             :app/question question)
      (failed state (:error result)))))

(defn- start-vote [state]
  (assoc state
         :app/screen :view.screen/voting
         :app/vote (voting/open (get-in state [:app/question :question/id])
                                (room/active-members (:app/room state)))))

(defn- submit-vote [state]
  (let [value (:app/selected-value state)
        nonce (str "local-" value)
        commitment (str value ":" nonce)
        result (voting/commit (:app/vote state)
                              (:app/local-member-id state)
                              commitment)]
    (if-let [vote (:ok result)]
      (assoc state
             :app/screen :view.screen/reveal-ready
             :app/vote vote
             :app/nonce nonce)
      (failed state (:error result)))))

(defn- acknowledge-reveal [state]
  (let [verify (fn [commitment value nonce]
                 (= commitment (str value ":" nonce)))
        result (voting/reveal (:app/vote state)
                              (:app/local-member-id state)
                              (:app/selected-value state)
                              (:app/nonce state)
                              verify)]
    (if-let [vote (:ok result)]
      (assoc state :app/screen :view.screen/revealed :app/vote vote)
      (failed state (:error result)))))

(defn- begin-discussion [state]
  (let [result (voting/begin-discussion (:app/vote state))]
    (if-let [vote (:ok result)]
      (assoc state :app/screen :view.screen/discussion :app/vote vote)
      (failed state (:error result)))))

(defn- reposition [state value]
  (let [sequence-number (inc (:app/position-sequence state))
        result (voting/reposition (:app/vote state)
                                  (:app/local-member-id state)
                                  value
                                  sequence-number)]
    (if-let [vote (:ok result)]
      (assoc state
             :app/vote vote
             :app/position-sequence sequence-number)
      (failed state (:error result)))))

(defn transition
  ([state event] (transition state event nil))
  ([state event dependencies]
  (case (:event/type event)
    :event/reset (initial-state)
    :event/create-room (create-room state dependencies event)
    :event/set-admission-mode (set-admission-mode
                                state (:room/admission-mode event))
    :event/share-room (begin-share-room state dependencies)
    :event/webrtc-offer-ready (share-room state dependencies
                                          (:transport/webrtc-sdp event))
    :event/webrtc-answer-ready
    (let [encoded (:app/accepted-invitation state)
          anonymous (:app/anonymous-identity state)
          now (.-millisecondsSinceEpoch (DateTime/now))
          result (invitation/accept-join-offer
                   (assoc dependencies :remote/session-description
                                       (:transport/webrtc-sdp event))
                   encoded now anonymous)]
      (if-let [accepted (:ok result)]
        (accepted-invitation-state state accepted anonymous encoded)
        (failed state (:error result))))
    :event/back-to-room (assoc state :app/screen :view.screen/room)
    :event/invitation-draft-changed (assoc state :app/invitation-draft
                                           (:invitation/text event))
    :event/scan-invitation (assoc state :app/screen :view.screen/scan-invitation)
    :event/join-with-invitation (accept-invitation state dependencies
                                                  (:app/invitation-draft state))
    :event/qr-detected (accept-invitation state dependencies
                                         (:invitation/text event))
    :event/invitation-link-received (accept-invitation
                                      state dependencies
                                      (:invitation/text event))
    :event/complete-join-response (complete-response
                                    state dependencies
                                    (:app/invitation-draft state))
    :event/transport-payload (complete-response
                               state dependencies (:transport/text event))
    :event/peer-found (peer-found state event)
    :event/peer-lost (peer-lost state event)
    :event/join-requested (join-requested state event)
    :event/approve-join (decide-join state event :join.decision/approve)
    :event/reject-join (decide-join state event :join.decision/reject)
    :event/remove-member (remove-member state event)
    :event/use-catalogue-question (use-catalogue-question state)
    :event/question-draft-changed (assoc state :app/question-draft
                                         (:question/text event))
    :event/submit-custom-question (submit-custom-question state)
    :event/approve-custom-question (approve-custom-question state)
    :event/start-vote (start-vote state)
    :event/select-vote (assoc state :app/selected-value (:vote/value event))
    :event/submit-vote (submit-vote state)
    :event/acknowledge-reveal (acknowledge-reveal state)
    :event/begin-discussion (begin-discussion state)
    :event/reposition (reposition state (:vote/value event))
    state)))

(defn start [dependencies]
  (let [state (atom (initial-state))
        render! (:view/render! dependencies)
        active-dependencies (atom dependencies)]
    (letfn [(dispatch! [event]
              (swap! state transition event @active-dependencies)
              (render! (presentation/view @state dispatch!)))]
      (reset! active-dependencies
              (assoc dependencies :application/emit! dispatch!))
      (render! (presentation/view @state dispatch!))
      (when-let [initial (:links/initial dependencies)]
        (dispatch! {:event/type :event/invitation-link-received
                    :invitation/text initial}))
      (let [peer-unsubscribe (when (:peers/subscribe! dependencies)
                               (peer-observer/start! dependencies dispatch!))
            link-unsubscribe (when (:links/subscribe! dependencies)
                               ((:links/subscribe! dependencies)
                                #(dispatch! {:event/type :event/invitation-link-received
                                             :invitation/text %})))]
        {:application/dispatch! dispatch!
         :application/state state
         :application/stop! (fn []
                              (when peer-unsubscribe (peer-unsubscribe))
                              (when link-unsubscribe (link-unsubscribe))
                              (when (:local/stop! dependencies)
                                ((:local/stop! dependencies)))
                              (when (:remote/stop! dependencies)
                                ((:remote/stop! dependencies))))}))))
