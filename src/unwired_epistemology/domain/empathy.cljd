(ns unwired-epistemology.domain.empathy)

(def opposing-values #{#{1 7} #{2 6}})

(defn opposing? [left right]
  (contains? opposing-values #{left right}))

(defn pairings [positions]
  (->> (for [[left-id left-value] positions
             [right-id right-value] positions
             :when (and (neg? (compare (str left-id) (str right-id)))
                        (opposing? left-value right-value))]
         {:pair/left-id left-id
          :pair/right-id right-id
          :pair/values #{left-value right-value}})
       (sort-by (juxt (comp str :pair/left-id)
                      (comp str :pair/right-id)))
       vec))

(defn opposite-member [positions member-id]
  (some (fn [{:pair/keys [left-id right-id]}]
          (cond
            (= member-id left-id) right-id
            (= member-id right-id) left-id))
        (pairings positions)))

(defn message [sender-id target-id text]
  (if (and (some? sender-id) (some? target-id) (seq text)
           (not= sender-id target-id))
    {:ok {:empathy/sender-id sender-id
          :empathy/target-id target-id
          :empathy/text text}}
    {:error :empathy.error/invalid-message}))
